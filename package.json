{
  "name": "teach-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test:coverage",
    "dev": "node scripts/dev.mjs",
    "test:e2e": "vitest run tests/service.e2e.test.ts tests/assessment.e2e.test.ts",
    "build": "node scripts/build.mjs",
    "release:check": "node scripts/release-check.mjs",
    "build:capture": "node scripts/build-capture.mjs",
    "release:check:capture": "node scripts/capture-release-check.mjs",
    "audit": "npm audit --audit-level=high",
    "deploy": "node scripts/deploy-capture.mjs",
    "deploy:check": "node scripts/deploy-capture.mjs --check-only",
    "verify:deploy": "node scripts/verify-deploy.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@types/node": "26.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.2-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "ts-fsrs": "6.0.0",
    "zod": "4.6.7"
  }
}
